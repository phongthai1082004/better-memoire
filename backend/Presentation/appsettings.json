{
  "AllowedHosts": "*",
  "Serilog": {
    "Using": [ "Serilog.Sinks.File" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "File",
        "Args": {
          "path": "Logs/Log-.txt",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 31,
          "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} [{Level:u3}] {Message:lj}{NewLine}{Exception}"
        }
      }
    ]
  },
  "JwtSettings": {
    "Key": "",
    "RefreshKey": "",
    "ClaimsIssuer": "BackendService",
    "Audience": "FrontendApp",
    "AccessTokenExpirationMinutes": 15,
    "RefreshTokenExpirationDays": 30
  },
  "Auth": {
    "ExpiryMinutes": 15,
    "MaxAttempts": 5,
    "ResendCooldownSeconds": 60
  },
  "Resend": {
    "ApiKey": "",
    "From": "onboarding@resend.dev",
    "BaseUrl": "https://api.resend.com"
  },
  "Google": {
    "ClientId": "572446164824-psbj1nnu7piu7m1cqfis013ls08aitkd.apps.googleusercontent.com"
  },
  "R2": {
    "WorkerUrl": "",
    "UploadSecret": "",
    "AdminToken": ""
  },
  "PostgresConfig": {
    "Host": "",
    "Port": 5432,
    "Database": "",
    "Username": "",
    "Password": ""
  },
  "Redis": {
    "ConnectionString": ""
  }
}

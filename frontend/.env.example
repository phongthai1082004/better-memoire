# Backend origin. The browser never calls this directly; Next.js route handlers
# proxy auth and future API requests server-side.
BACKEND_URL=http://localhost:5222

# Google OAuth 2.0 web client. The secret must stay server-side.
# Register this exact redirect URI in Google Cloud Console:
#   http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/callback/google
